# ===== 复制为 .env 后逐项填写：cp .env.example .env =====
# .env 已被 .gitignore 忽略，不会进代码库。请不要把这份文件发到群里。

# ---- 对外域名（不要带 https://，只写域名）----
# 已完成备案的域名才填大陆服务器；香港/海外节点无需备案
SITE_DOMAIN=exam.example.com
# 证书到期提醒邮箱
ACME_EMAIL=you@example.com
# 与上面保持一致，用于后端跨域白名单
PUBLIC_ORIGIN=https://exam.example.com

# ---- 数据库 ----
# 库名必须和 jdbc URL 里的一致，改动请同步 HNEXAM_DB_URL
MYSQL_DATABASE=hn_exam
MYSQL_USER=hn_exam
MYSQL_PASSWORD=请替换为强密码
MYSQL_ROOT_PASSWORD=请替换为另一个强密码

# ---- Redis ----
REDIS_PASSWORD=请替换为强密码

# ---- JWT 签名密钥 ----
# 生成方法（Linux/Mac/Git Bash）：openssl rand -base64 48
# 一旦上线不要再改，改了所有已登录用户立即失效
HNEXAM_JWT_SECRET=请替换为64位以上随机串

# ---- 初始管理员密码 ----
# 仅首次启动创建 admin 时使用；登录后系统会强制要求改密码
HNEXAM_BOOTSTRAP_PASSWORD=请替换为强密码

# ---- AI 出题功能（不用可以不填）----
HNEXAM_AI_API_KEY=

# ---- JVM 内存 ----
# 2核4G 机器保持默认；4核8G 可改为 -Xms512m -Xmx2048m -XX:+UseG1GC
JAVA_OPTS='-Xms256m -Xmx1024m -XX:+UseSerialGC -Dfile.encoding=UTF-8'

# ---- 数据库连接池 ----
# 114 名考生同时在线考试，20 足够；机器配置小不要调太高
HNEXAM_DB_POOL_MAX=20
HNEXAM_DB_POOL_MIN=5
