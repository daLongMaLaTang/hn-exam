# 一个域名同时提供前端页面和 /api 接口，浏览器眼里是同源，因此不存在跨域问题
# 证书由 Caddy 自动向 Let's Encrypt 申请并续期，前提是：
#   1. 域名 A 记录已指向本机公网 IP
#   2. 80 端口可从公网访问（ACME 校验用）
#   3. 大陆节点服务器要求域名已完成 ICP 备案

{$SITE_DOMAIN} {
	encode zstd gzip

	# 接口走后端，注意保留 /api 前缀，后端路由就是 /api/**
	handle /api/* {
		reverse_proxy app:8080
	}

	# 前端 SPA：history 路由必须回退到 index.html，否则刷新 /exam 这类地址会 404
	handle {
		root * /srv/www
		try_files {path} /index.html
		file_server
	}

	# 带 hash 的静态资源可以长缓存，index.html 不缓存，保证发版立即生效
	@assets path /assets/*
	header @assets Cache-Control "public, max-age=31536000, immutable"
	header /index.html Cache-Control "no-cache"

	header {
		X-Content-Type-Options nosniff
		X-Frame-Options SAMEORIGIN
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}

	# 题库 Excel 单文件上限 5MB，请求体留足余量
	request_body {
		max_size 12MB
	}
}

# ── 可选：如果以后把前端拆到 WorkBuddy 托管服务，再解开这一段 ──
# 需要先把 .env 里的 API_DOMAIN 也解析到本机，并在 .env 里补上
